# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env.example is intentionally committed; .env.local and others are ignored
.env.local
.env*.local
!.env.example

# local diagnostics folder (from our work, not needed in repo)
_desktop_logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
