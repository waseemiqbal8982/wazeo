# ===== Wazeo environment variables (example) =====
# Copy this file to .env.local and fill in the values.

# Supabase (from Supabase dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Project Settings -> Database -> Connection string -> URI / transaction pooler)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-region.pooler.supabase.com:6543/postgres

# SMM Provider API (v2 format - https://api.smm.com/api/v2 or your provider)
PROVIDER_API_URL=
PROVIDER_API_KEY=

# Mercury AI (OpenAI compatible chat completions endpoint)
MERCURY_BASE_URL=
MERCURY_API_KEY=
MERCURY_MODEL=

# Secret used to protect the cron endpoint (pick a long random string)
CRON_SECRET=
